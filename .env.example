# Database
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=portal
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false  # set true in production behind HTTPS
CORS_ORIGINS=["http://localhost:5173"]
UPLOADS_PATH=/app/data/uploads
# Optional: separate secrets for token types (defaults to SECRET_KEY)
# RESET_PASSWORD_SECRET=
# VERIFICATION_SECRET=
# Optional: echo all SQL statements (verbose; off by default)
# SQL_ECHO=false

# Override only if you want a custom test database location.
# TEST_DATABASE_URL=postgresql+asyncpg://portal:change-me-in-production@postgres:5432/portal_test

# Frontend
FRONTEND_PORT=5173
PUBLIC_API_URL=http://localhost:8000
