services:
  backend:
    volumes:
      - ./backend:/app
      - ./backend/data/uploads:/app/data/uploads
    command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload

  frontend:
    build:
      target: dev
    volumes:
      - ./frontend:/app
      - /app/node_modules
    command: npm run dev -- --host 0.0.0.0

  worker:
    volumes:
      - ./backend:/app
      - ./backend/data/uploads:/app/data/uploads
    command: arq app.workers.worker.WorkerSettings --watch /app
