# Database
POSTGRES_USER=portal
# Postgres superuser password. Must be set — leaving this empty makes the
# postgres container refuse to start, and weak/default values will be picked
# up by future security audits. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=portal
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
# SECRET_KEY signs JWTs AND derives the Fernet key for module_configs secret
# encryption. Must be ≥ 32 chars and not a known placeholder — startup will
# refuse to boot otherwise.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=false  # set true in production behind HTTPS
# Set to your portal origin(s). NEVER set to ["*"] — startup will refuse.
# Cross-origin POST/PUT to admin endpoints requires the Origin to be in this list.
CORS_ORIGINS=["http://localhost:5173"]
UPLOADS_PATH=/app/data/uploads
# Optional: separate secrets for token types (defaults to SECRET_KEY)
# RESET_PASSWORD_SECRET=
# VERIFICATION_SECRET=
# Optional: echo all SQL statements (verbose; off by default)
# SQL_ECHO=false

# Phone-home (P0d.2b) — leave unset to run portal in standalone mode (no OC integration)
# OC_URL=https://oc.hoelscherautomation.com
# OC_TOKEN=
# PHONE_HOME_INTERVAL_SECONDS=300
# PORTAL_VERSION=0.5.0

# Ask Docs (P1.1) — RAG infrastructure
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
ASK_DOCS_EMBEDDING_MODEL=nomic-embed-text
ASK_DOCS_CHUNK_SIZE_TOKENS=1024
ASK_DOCS_CHUNK_OVERLAP_TOKENS=128
# Ask Docs chat (P1.2) — required for Ask Docs chat in default Anthropic mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ASK_DOCS_TOP_K=8
ASK_DOCS_MAX_ANSWER_TOKENS=1024

# Override only if you want a custom test database location. The default
# derives from DATABASE_URL by appending _test, so this is rarely needed.
# TEST_DATABASE_URL=postgresql+asyncpg://portal:YOUR_PASSWORD@postgres:5432/portal_test

# Frontend
FRONTEND_PORT=5173
PUBLIC_API_URL=http://localhost:8000
